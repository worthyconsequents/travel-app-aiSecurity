let clusters = Resources.*[ Type == 'AWS::EKS::Cluster' ]
let databases = Resources.*[ Type == 'AWS::RDS::DBInstance' ]
let groups = Resources.*[ Type == 'AWS::EC2::SecurityGroup' Properties.SecurityGroupIngress exists ]
rule private_control_plane when %clusters !empty {
    %clusters.Properties.ResourcesVpcConfig {
        EndpointPrivateAccess == true
        PublicAccessCidrs[*] != '0.0.0.0/0'
    }
}
rule private_encrypted_database when %databases !empty {
    %databases {
        DeletionPolicy == 'Retain'
        UpdateReplacePolicy == 'Retain'
        Properties {
            PubliclyAccessible == false
            StorageEncrypted == true
        }
    }
}
let world_ingress = %groups.Properties.SecurityGroupIngress[ CidrIp == '0.0.0.0/0' ]
let ipv6_world_ingress = %groups.Properties.SecurityGroupIngress[ CidrIpv6 == '::/0' ]
rule public_https_requires_explicit_opt_in when %world_ingress !empty {
    Metadata.BoringTravelPublicWeb == true
    %world_ingress {
        IpProtocol == 'tcp'
        FromPort == 443
        ToPort == 443
    }
}
rule no_public_ipv6 {
    %ipv6_world_ingress empty
}
