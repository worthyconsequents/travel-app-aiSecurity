# Offline example only. Copy to an ignored private file; never source as shell code.
DEPLOYMENT_PROFILE=trend-aws
DEPLOYMENT_PREFIX=dannytran-boring-travel-trend
DEPLOYMENT_ENV=lab01
DEPLOYMENT_COUNT=1
AWS_REGION=us-east-1
AWS_EXPECTED_ACCOUNT_ID=123456789012
AWS_OPERATOR_ARN=arn:aws:iam::123456789012:user/example
AWS_EKS_VERSION=1.35
DEPLOYMENT_HOSTNAME=boring-travel.example.com
DEPLOYMENT_HOSTED_ZONE_ID=Z0123456789
DEPLOYMENT_ALLOWED_CIDR=203.0.113.1/32
# Optional planning amount; does not create or enforce an AWS billing cap.
AWS_TEST_BUDGET_USD=
ENABLE_PAID_INFERENCE=false
