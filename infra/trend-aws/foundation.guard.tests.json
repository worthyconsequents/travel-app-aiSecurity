[
  {
    "name": "explicit public website allows HTTPS",
    "input": {
      "Metadata": {
        "BoringTravelPublicWeb": true
      },
      "Resources": {
        "IngressSecurity": {
          "Type": "AWS::EC2::SecurityGroup",
          "Properties": {
            "SecurityGroupIngress": [
              {
                "IpProtocol": "tcp",
                "FromPort": 443,
                "ToPort": 443,
                "CidrIp": "0.0.0.0/0"
              }
            ]
          }
        },
        "Cluster": {
          "Type": "AWS::EKS::Cluster",
          "Properties": {
            "ResourcesVpcConfig": {
              "EndpointPrivateAccess": true,
              "PublicAccessCidrs": [
                "203.0.113.1/32"
              ]
            }
          },
          "DependsOn": "ClusterLogs"
        },
        "Database": {
          "Type": "AWS::RDS::DBInstance",
          "Properties": {
            "PubliclyAccessible": false,
            "StorageEncrypted": true
          },
          "DeletionPolicy": "Retain",
          "UpdateReplacePolicy": "Retain"
        }
      }
    },
    "expectations": {
      "rules": {
        "public_https_requires_explicit_opt_in": "PASS"
      }
    }
  },
