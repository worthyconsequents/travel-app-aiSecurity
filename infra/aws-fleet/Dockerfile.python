FROM python:3.12-slim AS certificates
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl --fail --proto '=https' --tlsv1.2 https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -o /rds-ca.pem

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY services ./services
COPY scripts ./scripts
COPY scenario-runner ./scenario-runner
COPY --from=certificates /rds-ca.pem /app/rds-ca.pem
RUN useradd --create-home app && chown -R app:app /app
USER app
ENV PATH="/app/.venv/bin:$PATH"
CMD ["uvicorn", "services.api:app", "--host", "127.0.0.1", "--port", "8000"]
