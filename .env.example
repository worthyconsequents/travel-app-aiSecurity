APP_MODE=local
MODEL_MODE=mock
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=
POSTGRES_DB=travel_demo
POSTGRES_USER=travel_demo
POSTGRES_PASSWORD=local-synthetic-only
PUBLIC_PORT=8080

# Private operator console. Generate a unique password; never commit .env.
MONITOR_PASSWORD=
MONITOR_PASSWORD_SOURCE=env
MONITOR_SECRET_ARN=
ENABLE_AWS_MONITOR_SECRET=false
MONITOR_COOKIE_SECURE=false

# Optional AWS fleet. A copy is a full application, not a replica behind one site.
# Preview is offline. AWS writes require --apply and --acknowledge-costs.
DEPLOYMENT_TARGET=aws
DEPLOYMENT_PREFIX=dannytran-travel
DEPLOYMENT_ENV=lab01
DEPLOYMENT_COUNT=3
AWS_EXPECTED_ACCOUNT_ID=
DEPLOYMENT_DOMAIN=
DEPLOYMENT_HOSTED_ZONE_ID=
DEPLOYMENT_CERTIFICATE_ARN=
# Your operator public IPv4 /32, or a trusted subnet of /24 or narrower.
DEPLOYMENT_ALLOWED_CIDR=
# ONE existing Trend AI Guard detection secret, same account and Region.
# Store {"token":"..."} there; this file holds only its ARN.
AI_GUARD_SECRET_ARN=
AI_GUARD_SECRET_KMS_ARN=
AI_GUARD_URL=https://api.xdr.trendmicro.com/v3.0/aiSecurity/applyGuardrails
# Filled from the publish-images output; ECR URI@sha256:... references only.
AWS_PYTHON_IMAGE=
AWS_FRONTEND_IMAGE=
AWS_EDGE_IMAGE=
ENABLE_PAID_INFERENCE=false
AGENTCORE_MODEL_ID=
AGENTCORE_MANTLE_PROJECT_ARN=
